#!/usr/bin/env python3
"""Ask the UAT gate to test one pull request commit and wait for its verdict, for dsh-superagent workers.

Usage, run as a background job:
  uat-test <owner/repo> <pr number> <head sha>            request UAT of the head and wait
  uat-test --verify <owner/repo> <pr number> <head sha>   before merging: does its PASS still hold?
  uat-test --artifact <run id> <path>                     print one file a run kept (logs, evidence)

DSH Superagent decides when to test and what to do next; this command only
asks the trusted UAT gate (the uat-gate service) for a run of the head. The
gate re-reads the PR, its issue and the policy from GitHub itself, runs the
DeepSeek tester on its isolated runner and publishes the `superagent/uat`
check through its GitHub App. This command accepts no verdict and sends none:
it checks that the gate's answer is the App's check on GitHub before trusting
it, and a status or check from anyone else is ignored.

The report (verdict, failing scenarios with expected, observed and
reproduction, the run id for --artifact) is printed and kept under
~/.local/state/uat-test.

Exit status: 0 PASS, or no UAT required, for <head sha> (for --verify: the
result still holds); 1 FAIL (--verify: it does not); 2 BLOCKED (including no
failing rounds left); 3 no verdict (gate unreachable, timeout, a mismatch with
GitHub, or an error).
"""
import json
import os
import re
import subprocess
import sys
import time
import urllib.error
import urllib.request

# Written by superagent-entrypoint.sh: the App id, gate URL and request token.
CONFIG = os.environ.get('UAT_TEST_CONFIG', '/run/superagent-secrets/uat.json')
MARKER = re.compile(r'<!-- superagent-uat (\{.*?\}) -->')
HISTORY = os.path.expanduser('~/.local/state/uat-test')
GH = os.environ.get('UAT_TEST_GH', 'gh-agent')
POLL_SECONDS = float(os.environ.get('UAT_TEST_POLL_SECONDS', '15'))
TIMEOUT_SECONDS = float(os.environ.get('UAT_TEST_TIMEOUT_SECONDS', str(150 * 60)))
# How long the gate may stay unreachable before giving up (restarts take well under this).
OUTAGE_SECONDS = float(os.environ.get('UAT_TEST_OUTAGE_SECONDS', '300'))
MAX_STALE_REQUESTS = 2
EXIT = {'PASS': 0, 'NOT_REQUIRED': 0, 'FAIL': 1, 'BLOCKED': 2}


def fail(message, status=3):
    print(f'uat-test: {message}', file=sys.stderr)
    sys.exit(status)


def load_config():
    try:
        with open(CONFIG, encoding='utf-8') as file:
            config = json.load(file)
        return int(config['app_id']), config['gate_url'].rstrip('/'), config['token'], config.get('check_name') or 'superagent/uat'
    except (OSError, ValueError, KeyError, TypeError) as error:
        fail(f'UAT is not configured in this deployment ({CONFIG}: {error})')


def gate(method, path, body=None):
    """(status, answer) from the gate, retrying while it is unreachable for up to OUTAGE_SECONDS."""
    _, url, token, _ = load_config()
    deadline = time.monotonic() + OUTAGE_SECONDS
    while True:
        request = urllib.request.Request(url + path, method=method, data=None if body is None else json.dumps(body).encode(),
                                         headers={'authorization': f'Bearer {token}', 'content-type': 'application/json'})
        try:
            with urllib.request.urlopen(request, timeout=60) as response:
                raw = response.read()
                return response.status, (raw if path.startswith('/v1/uat/runs/') and '/files/' in path else json.loads(raw))
        except urllib.error.HTTPError as error:
            try:
                return error.code, json.loads(error.read())
            except ValueError:
                return error.code, {'error': f'HTTP {error.code}'}
        except (urllib.error.URLError, OSError) as error:
            if time.monotonic() > deadline:
                fail(f'the UAT gate at {url} is unreachable: {error}')
            time.sleep(min(POLL_SECONDS, 10))


def gh(*args):
    result = subprocess.run([GH, *args], capture_output=True, text=True)
    if result.returncode:
        fail(f'{GH} {" ".join(args[:2])} failed: {result.stderr.strip()}')
    return result.stdout


def github_check(repository, sha, app_id, check_name):
    """The App's newest check run of the UAT check on sha, and its marker."""
    answer = json.loads(gh('api', f'repos/{repository}/commits/{sha}/check-runs?check_name={check_name}'
                                  f'&app_id={app_id}&filter=all&per_page=100'))
    runs = sorted((run for run in answer['check_runs']
                   if run['name'] == check_name and (run.get('app') or {}).get('id') == app_id),
                  key=lambda run: run['id'], reverse=True)
    if not runs:
        return None, None
    match = MARKER.search((runs[0].get('output') or {}).get('text') or '')
    return runs[0], json.loads(match.group(1)) if match else None


def wait(repository, number, sha):
    """The completed gate run for the head, requesting it (again when it went stale)."""
    started, stale = time.monotonic(), 0
    while True:
        status, run = gate('POST', '/v1/uat/runs', {'repository': repository, 'pr': int(number), 'head_sha': sha})
        if status != 200:
            fail(f'the UAT gate refused the request (HTTP {status}): {run.get("error")}')
        print(f'uat-test: UAT run {run["run_id"]} for {sha} is {run["state"].lower()}', flush=True)
        while run['state'] != 'COMPLETE':
            if time.monotonic() - started > TIMEOUT_SECONDS:
                fail(f'no UAT verdict for {sha} within {TIMEOUT_SECONDS / 60:.0f} minutes (run {run["run_id"]})')
            time.sleep(POLL_SECONDS)
            status, run = gate('GET', f'/v1/uat/runs/{run["run_id"]}')
            if status != 200:
                fail(f'the UAT gate lost run (HTTP {status}): {run.get("error")}')
        if run['verdict'] != 'STALE':
            return run
        stale += 1
        if stale > MAX_STALE_REQUESTS:
            fail(f'UAT run {run["run_id"]} went stale {stale} times: the PR or its issue keeps changing')
        print(f'uat-test: UAT run {run["run_id"]} is stale ({run.get("title")}); requesting a new one', flush=True)


def confirm(repository, sha, run):
    """Trust the gate's answer only when the App's check on GitHub says the same."""
    app_id, _, _, check_name = load_config()
    check, marker = github_check(repository, sha, app_id, check_name)
    if not check or not marker or marker.get('run_id') != run['run_id'] or marker.get('verdict') != run['verdict'] \
            or check['status'] != 'completed':
        fail(f'the {check_name} check of the UAT App on {sha} does not match UAT run {run["run_id"]} '
             f'({run["verdict"]}); not trusting it')
    return marker


def report(repository, number, sha, run, marker):
    body = (f'# {run["title"]}\n\n{run["summary"] or ""}\n\n{run["text"] or ""}\n\n'
            f'UAT run: {run["run_id"]} (files: uat-test --artifact {run["run_id"]} <path>)\n').replace('\n\n\n', '\n\n')
    directory = os.path.join(HISTORY, repository, f'pr-{number}')
    os.makedirs(directory, exist_ok=True)
    saved = os.path.join(directory, f'{time.strftime("%Y%m%dT%H%M%SZ", time.gmtime())}-{sha[:12]}.md')
    with open(saved, 'w', encoding='utf-8') as file:
        file.write(body)
    print(body)
    print(f'uat-test: the whole report is in {saved}')
    print(f'uat-test: failing rounds used: {marker.get("failed_rounds", 0)} of {marker.get("max_failed_rounds", "?")}')
    print(f'uat-test: {run["verdict"]} for {sha}')
    sys.exit(EXIT[run['verdict']])


def main(args):
    if len(args) == 3 and args[0] == '--artifact':
        status, data = gate('GET', f'/v1/uat/runs/{args[1]}/files/{args[2].lstrip("/")}')
        if status != 200:
            fail(f'no such file in UAT run {args[1]}: {data.get("error") if isinstance(data, dict) else status}')
        sys.stdout.write(data.decode('utf-8', 'replace'))
        return
    verify = bool(args) and args[0] == '--verify'
    args = args[1:] if verify else args
    if len(args) != 3 or not args[1].isdigit() or not re.fullmatch(r'[0-9a-f]{40}', args[2]):
        fail('usage: uat-test [--verify] <owner/repo> <pr number> <full 40-character head sha>, '
             'or uat-test --artifact <run id> <path>')
    repository, number, sha = args
    load_config()
    head = json.loads(gh('pr', 'view', number, '--repo', repository, '--json', 'headRefOid'))['headRefOid']
    if head != sha:
        fail(f'the PR head is {head}, not {sha}: test the current head')
    if verify:
        status, answer = gate('POST', '/v1/uat/verify', {'repository': repository, 'pr': int(number), 'head_sha': sha})
        if status != 200:
            fail(f'the UAT gate refused the check (HTTP {status}): {answer.get("error")}')
        print(f'uat-test: {"current" if answer["current"] else "NOT current"}: {answer["reason"]}')
        sys.exit(0 if answer['current'] else 1)
    run = wait(repository, number, sha)
    if run['verdict'] not in EXIT:
        fail(f'UAT run {run["run_id"]} ended with {run["verdict"]!r}')
    report(repository, number, sha, run, confirm(repository, sha, run))


if __name__ == '__main__':
    main(sys.argv[1:])
