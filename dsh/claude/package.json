{
  "name": "superagent-claude",
  "version": "0.1.0",
  "private": true,
  "description": "Thin Claude Code chat adapter for Superagent DSH: one turn is one Claude Code query.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./route": "./route.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "route.js",
    "turn.js",
    "credentials.js",
    "sessions.js",
    "permissions.js",
    "can-use-tool.js",
    "cordis.patch.yml",
    "package.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "manifestVersion": 1
  },
  "engines": {
    "node": ">=20",
    "dsh": "^0.2.1-alpha.2"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.318"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": ">=0.2.1-alpha.2",
    "@deepseek-ai/dsh-agent": ">=0.2.1-alpha.2"
  }
}
