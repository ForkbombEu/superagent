# Use Coolify's Environment Variables for real deployment, not this file.
DEEPSEEK_API_KEY=replace-with-api-key
GH_TOKEN=replace-with-classic-github-token
GITHUB_REPOSITORY=ForkbombEu/credimi-attestbook
# Claude Code PR reviewer: set one. Subscription token from `claude setup-token`, or an API key.
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=
# Optional reviewer model (`opus`, `sonnet` or a full model id) and effort
# (low, medium, high, xhigh or max); empty uses Claude Code's defaults.
SUPERAGENT_REVIEWER_MODEL=
SUPERAGENT_REVIEWER_EFFORT=
# Optional user acceptance tests (README "User acceptance tests"), run by the uat-gate
# service: the numeric id of the UAT GitHub App turns them on. Empty: no UAT.
SUPERAGENT_UAT_APP_ID=
# The UAT App's private key (PEM; \n for newlines is fine). Only uat-gate receives it.
SUPERAGENT_UAT_APP_PRIVATE_KEY=
# Optional; looked up from the repository when empty.
SUPERAGENT_UAT_INSTALLATION_ID=
# Shared request token between superagent and uat-gate, 32+ random characters
# (e.g. `openssl rand -hex 32`). It lets the worker ask for runs, nothing more.
SUPERAGENT_UAT_GATE_TOKEN=
# The gate's policy: environments the issue may pick (local, preview), failing rounds
# per PR, tester time limit per attempt, parallel runs; optional tester model.
SUPERAGENT_UAT_ENVIRONMENTS=local
SUPERAGENT_UAT_MAX_FAILED_ROUNDS=3
SUPERAGENT_UAT_TESTER_TIMEOUT_MINUTES=30
SUPERAGENT_UAT_CONCURRENCY=2
SUPERAGENT_UAT_MODEL=
# Preview environment (add `preview` above): URL template with {pr}, allowed hosts,
# the path answering the deployed commit SHA, and optional test credentials (JSON
# object of 8+ character values).
SUPERAGENT_UAT_PREVIEW_URL=
SUPERAGENT_UAT_PREVIEW_ALLOWED_HOSTS=
SUPERAGENT_UAT_PREVIEW_REVISION_PATH=
SUPERAGENT_UAT_PREVIEW_CREDENTIALS=
# Leave empty; superagent/uat-shadow only while validating the gate next to an old publisher.
SUPERAGENT_UAT_CHECK_NAME=
# Set by Coolify from the domain of the "dashboard" service; only for running outside Coolify.
SERVICE_URL_DASHBOARD=https://superagent.example.com
SERVICE_FQDN_DASHBOARD=superagent.example.com
# Optional: applied to the Superagent settings on every start; leave empty to manage in the panel.
# GitHub logins that may ask for work, comma- or space-separated.
SUPERAGENT_GITHUB_ALLOWED_USERS=
# Executor model; provider and model ids as the panel's model picker lists them.
SUPERAGENT_EXECUTOR_PROVIDER=
SUPERAGENT_EXECUTOR_MODEL=
SUPERAGENT_EXECUTOR_REASONING_EFFORT=
# Tickets worked on at the same time (1-16); empty keeps the panel value (default 3).
SUPERAGENT_MAX_WORKERS=
