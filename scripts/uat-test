#!/usr/bin/env python3
"""Wait for the trusted UAT verdict on one pull request commit, for dsh-superagent workers.

Usage: uat-test <owner/repo> <pr number> <head sha>

The superagent-uat workflow of the target repository (templates/superagent-uat.yml)
tests every new PR head by itself and publishes the `superagent/uat` check
through its own GitHub App. This command only asks for a run when none starts
(or the last result went stale) and reads that App's check run: it cannot
produce a verdict, and a status or check from anyone else is ignored.

The report (verdict, failing scenarios with expected, observed and
reproduction, the run with the evidence) is printed and kept under
~/.local/state/uat-test.

Exit status: 0 PASS, or no UAT required, for <head sha>; 1 FAIL; 2 BLOCKED
(including no failing rounds left); 3 no verdict (no controller answered, or
an error).
"""
import json
import os
import re
import subprocess
import sys
import time

# Written by superagent-entrypoint.sh from SUPERAGENT_UAT_APP_ID.
CONFIG = os.environ.get('UAT_TEST_CONFIG', '/run/superagent-secrets/uat.json')
CHECK_NAME = 'superagent/uat'
MARKER = re.compile(r'<!-- superagent-uat (\{.*?\}) -->')
HISTORY = os.path.expanduser('~/.local/state/uat-test')
GH = os.environ.get('UAT_TEST_GH', 'gh-agent')
POLL_SECONDS = float(os.environ.get('UAT_TEST_POLL_SECONDS', '30'))
# A run starts within a minute or two of a push; ask for one after this long without one.
GRACE_SECONDS = float(os.environ.get('UAT_TEST_GRACE_SECONDS', '240'))
TIMEOUT_SECONDS = float(os.environ.get('UAT_TEST_TIMEOUT_SECONDS', str(150 * 60)))
MAX_REQUESTS = 2
EXIT = {'PASS': 0, 'NOT_REQUIRED': 0, 'FAIL': 1, 'BLOCKED': 2}


def fail(message, status=3):
    print(f'uat-test: {message}', file=sys.stderr)
    sys.exit(status)


def gh(*args, stdin=None):
    result = subprocess.run([GH, *args], input=stdin, capture_output=True, text=True)
    if result.returncode:
        fail(f'{GH} {" ".join(args[:2])} failed: {result.stderr.strip()}')
    return result.stdout


def latest(repository, sha, app_id):
    """The App's newest superagent/uat check run on sha with its marker, or (None, None)."""
    answer = json.loads(gh('api', f'repos/{repository}/commits/{sha}/check-runs?check_name={CHECK_NAME}'
                                  f'&app_id={app_id}&filter=all&per_page=100'))
    runs = sorted((run for run in answer['check_runs']
                   if run['name'] == CHECK_NAME and (run.get('app') or {}).get('id') == app_id),
                  key=lambda run: run['id'], reverse=True)
    if not runs:
        return None, None
    match = MARKER.search((runs[0].get('output') or {}).get('text') or '')
    return runs[0], json.loads(match.group(1)) if match else None


def request_run(repository, number):
    gh('api', '--method', 'POST', f'repos/{repository}/dispatches', '--input', '-',
       stdin=json.dumps({'event_type': 'superagent-uat', 'client_payload': {'pr': int(number)}}))
    print(f'uat-test: requested a UAT run for PR #{number}', flush=True)


def main():
    if len(sys.argv) != 4 or not sys.argv[2].isdigit() or not re.fullmatch(r'[0-9a-f]{40}', sys.argv[3]):
        fail('usage: uat-test <owner/repo> <pr number> <full 40-character head sha>')
    repository, number, sha = sys.argv[1:]
    try:
        with open(CONFIG, encoding='utf-8') as file:
            app_id = int(json.load(file)['app_id'])
    except (OSError, ValueError, KeyError) as error:
        fail(f'UAT is not configured in this deployment ({CONFIG}: {error})')
    head = json.loads(gh('pr', 'view', number, '--repo', repository, '--json', 'headRefOid'))['headRefOid']
    if head != sha:
        fail(f'the PR head is {head}, not {sha}: test the current head')

    started, requests, stale_id = time.monotonic(), 0, None
    while time.monotonic() - started < TIMEOUT_SECONDS:
        run, marker = latest(repository, sha, app_id)
        if run and stale_id is not None and run['id'] <= stale_id:
            run = marker = None
        waited = time.monotonic() - started
        if run and run['status'] == 'completed' and marker and marker.get('sha') == sha:
            if marker['verdict'] in EXIT:
                return report(repository, number, sha, run, marker)
            if marker['verdict'] == 'STALE' and requests < MAX_REQUESTS:
                stale_id, requests = run['id'], requests + 1
                print('uat-test: the last result is stale; requesting a new run', flush=True)
                request_run(repository, number)
        elif not run and waited > GRACE_SECONDS * (requests + 1):
            if requests >= MAX_REQUESTS:
                fail(f'no UAT run started for {sha} after {requests} requests: is the superagent-uat workflow '
                     'installed on the default branch and its GitHub App configured?')
            requests += 1
            request_run(repository, number)
        time.sleep(POLL_SECONDS)
    fail(f'no UAT verdict for {sha} within {TIMEOUT_SECONDS / 60:.0f} minutes')


def report(repository, number, sha, run, marker):
    output = run.get('output') or {}
    text = MARKER.sub('', output.get('text') or '').strip()
    body = (f'# {output.get("title")}\n\n{output.get("summary") or ""}\n\n{text}\n\n'
            f'Run, evidence and logs: {run.get("details_url") or marker.get("run_url")}\n').replace('\n\n\n', '\n\n')
    directory = os.path.join(HISTORY, repository, f'pr-{number}')
    os.makedirs(directory, exist_ok=True)
    saved = os.path.join(directory, f'{time.strftime("%Y%m%dT%H%M%SZ", time.gmtime())}-{sha[:12]}.md')
    with open(saved, 'w', encoding='utf-8') as file:
        file.write(body)
    print(body)
    print(f'uat-test: the whole report is in {saved}')
    print(f'uat-test: failing rounds used: {marker.get("failed_rounds", 0)} of {marker.get("max_failed_rounds", "?")}')
    print(f'uat-test: {marker["verdict"]} for {sha}')
    sys.exit(EXIT[marker['verdict']])


if __name__ == '__main__':
    main()
