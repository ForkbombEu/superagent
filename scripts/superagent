#!/usr/bin/env python3
"""superagent check/merge/init/upgrade: PR gates, or scaffold a target repository.

`check` resolves repository, PR and head, then either prints the plan
(`--dry-run`) or runs the next missing check under a per-PR lock.
`merge` re-reads head and title, checks every Delivery merge condition, then
squash-merges with `--match-head-commit` (or `--dry-run` reports only).
`init` copies target-owned templates (AGENTS.md, UAT config, planning skills)
into a caller-chosen directory.
`upgrade` refreshes planning skills from the same templates and writes
`.superagent/UPGRADE.md` as a human/agent work order of what changed.
"""
import fcntl
import json
import os
import re
import shutil
import subprocess
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import superagent_checks as checks

CHECK = 'superagent'
UAT_CONFIG = os.environ.get('UAT_TEST_CONFIG', '/run/superagent-secrets/uat.json')
MAX_FAILED_REVIEWS = 3
PASS_VERDICTS = {'PASS', 'NOT_REQUIRED'}


def fail(message, status=checks.Exit.PRECONDITION):
    print(f'{CHECK}: {message}', file=sys.stderr)
    sys.exit(status)


def git(*args):
    result = subprocess.run(['git', *args], capture_output=True, text=True)
    if result.returncode:
        fail(f'git {" ".join(args)} failed: {result.stderr.strip()}')
    return result.stdout.strip()


def resolve():
    repository = os.environ.get('DSH_SUPERAGENT_GITHUB_REPOSITORY', '').strip()
    if not repository:
        fail('DSH_SUPERAGENT_GITHUB_REPOSITORY is not set')
    sha = git('rev-parse', 'HEAD')
    view = checks.gh('pr', 'view', '--repo', repository, '--json', 'number,headRefOid')
    if view.returncode:
        fail('no pull request for the current branch')
    pr = json.loads(view.stdout)
    number, head = pr['number'], pr['headRefOid']
    if head != sha:
        behind = subprocess.run(['git', 'merge-base', '--is-ancestor', sha, head], capture_output=True)
        if behind.returncode == 0:
            fail(f'local HEAD is behind the PR head {head}: run git pull')
        fail(f'the PR head is {head}, not {sha}: run against the current head')
    return repository, number, sha


def uat_on():
    return os.path.exists(UAT_CONFIG)


def stored_uat_report(directory, sha):
    if not os.path.isdir(directory):
        return None
    marker = f'-{sha[:12]}.md'
    for name in sorted(os.listdir(directory)):
        if name.endswith(marker):
            return name
    return None


def stored_uat_verdict(directory, sha):
    path = os.path.join(directory, f'{sha}.json')
    if not os.path.isfile(path):
        return None
    with open(path, encoding='utf-8') as file:
        data = json.load(file)
    if data.get('sha') != sha:
        return None
    return data.get('verdict')


def write_uat_verdict(directory, sha, verdict):
    os.makedirs(directory, exist_ok=True)
    path = os.path.join(directory, f'{sha}.json')
    with open(path, 'w', encoding='utf-8') as file:
        json.dump({'sha': sha, 'verdict': verdict}, file)
        file.write('\n')


def stored_review(directory, sha):
    if not os.path.isdir(directory):
        return None
    for name in sorted(os.listdir(directory)):
        if not name.endswith('.json'):
            continue
        path = os.path.join(directory, name)
        with open(path, encoding='utf-8') as file:
            data = json.load(file)
        if data.get('sha') == sha:
            data['_stem'] = name[:-5]
            data['_path'] = path
            return data
    return None


def failed_reviews(directory):
    if not os.path.isdir(directory):
        return []
    names = []
    for name in sorted(os.listdir(directory)):
        if not name.endswith('.json'):
            continue
        path = os.path.join(directory, name)
        with open(path, encoding='utf-8') as file:
            data = json.load(file)
        if data.get('verdict') == 'FAIL':
            names.append(f'{name[:-5]}.md')
    return names


def lock_path(repository, number):
    return os.path.join(checks.history_dir(CHECK, repository, number), 'lock')


def acquire_lock(repository, number):
    path = lock_path(repository, number)
    os.makedirs(os.path.dirname(path), exist_ok=True)
    handle = open(path, 'a+', encoding='utf-8')
    fcntl.flock(handle.fileno(), fcntl.LOCK_EX)
    return handle


def parse_child_verdict(stdout, command, sha):
    match = re.search(rf'^{re.escape(command)}: ([A-Z_]+) for {re.escape(sha)}$', stdout, re.MULTILINE)
    return match.group(1) if match else None


def parse_child_detail(stdout, command):
    match = re.search(rf'^{re.escape(command)}: detail (.+)$', stdout, re.MULTILINE)
    return match.group(1).strip() if match else None


def parse_child_rounds(stdout, command):
    match = re.search(rf'^{re.escape(command)}: rounds (\d+) of (\d+|\?)$', stdout, re.MULTILINE)
    if not match:
        return None, None
    allowed = None if match.group(2) == '?' else int(match.group(2))
    return int(match.group(1)), allowed


def run_command(command, repository, number, sha):
    result = subprocess.run(
        [command, repository, str(number), sha],
        capture_output=True, text=True,
    )
    if result.stdout:
        # Child progress lines stay visible for long UAT waits; compact lines are re-aggregated.
        sys.stderr.write(result.stderr)
        # Keep non-compact child stdout on stderr so the aggregate owns stdout.
        for line in result.stdout.splitlines():
            if not line.startswith(f'{command}:'):
                print(line, file=sys.stderr, flush=True)
    elif result.stderr:
        sys.stderr.write(result.stderr)
    verdict = parse_child_verdict(result.stdout, command, sha)
    if not verdict:
        if result.returncode == checks.Exit.PRECONDITION:
            fail(result.stderr.strip() or f'{command} failed precondition', checks.Exit.PRECONDITION)
        fail(result.stderr.strip() or f'{command} produced no verdict', checks.Exit.RETRY)
    return result.returncode, verdict, result.stdout


def next_for(verdict, *, review_pending=False, failed=None):
    if verdict in PASS_VERDICTS:
        return 'run superagent check' if review_pending else 'done'
    if verdict == 'FAIL':
        if failed is not None:
            return (
                f'failed reviews so far: {", ".join(failed)}'
                if failed else 'failed reviews so far: (none)'
            )
        return 'fix and push'
    if verdict == 'BLOCKED':
        return 'stop'
    if verdict == 'RETRY':
        return 'retry'
    return 'stop'


def finish(verdict, sha, *, next_step, detail_file=None, rounds_used=None, rounds_allowed=None):
    code = checks.print_result(checks.Result(
        check=CHECK, verdict=verdict, sha=sha,
        rounds_used=rounds_used, rounds_allowed=rounds_allowed,
        next_step=next_step, detail_file=detail_file,
    ))
    sys.exit(code)


def dry_run():
    repository, number, sha = resolve()
    print(f'{CHECK} check: {repository}#{number} at {sha}')
    uat_dir = checks.history_dir('uat-test', repository, number)
    review_dir = checks.history_dir('claude-review', repository, number)
    uat = stored_uat_report(uat_dir, sha)
    if uat:
        print(f'uat-test: result for {sha} ({uat})')
    else:
        print(f'uat-test: no result for {sha}')
    review = stored_review(review_dir, sha)
    if review:
        print(f'claude-review: {review["verdict"]} for {sha}')
    else:
        print(f'claude-review: no result for {sha}')
    sys.exit(checks.Exit.PASS)


def run_check():
    repository, number, sha = resolve()
    uat_dir = checks.history_dir('uat-test', repository, number)
    review_dir = checks.history_dir('claude-review', repository, number)
    lock = acquire_lock(repository, number)
    try:
        review = stored_review(review_dir, sha)
        uat_report = stored_uat_report(uat_dir, sha)
        uat_verdict = stored_uat_verdict(uat_dir, sha)

        if uat_on() and not uat_report:
            _code, verdict, stdout = run_command('uat-test', repository, number, sha)
            write_uat_verdict(uat_dir, sha, verdict)
            detail = parse_child_detail(stdout, 'uat-test')
            rounds_used, rounds_allowed = parse_child_rounds(stdout, 'uat-test')
            pending = verdict in PASS_VERDICTS and not stored_review(review_dir, sha)
            finish(
                verdict, sha,
                next_step=next_for(verdict, review_pending=pending),
                detail_file=detail if verdict == 'FAIL' else None,
                rounds_used=rounds_used, rounds_allowed=rounds_allowed,
            )

        if uat_on() and uat_report and uat_verdict and uat_verdict not in PASS_VERDICTS:
            # Known stored non-pass stops before review. A report without a sidecar
            # (uat-test run outside superagent) falls through; claude-review verifies.
            detail = os.path.join(uat_dir, uat_report) if uat_verdict == 'FAIL' else None
            finish(uat_verdict, sha, next_step=next_for(uat_verdict), detail_file=detail)

        failed = failed_reviews(review_dir)
        if not review and len(failed) >= MAX_FAILED_REVIEWS:
            finish(
                'BLOCKED', sha,
                next_step='stop: three failed reviews',
                rounds_used=len(failed), rounds_allowed=MAX_FAILED_REVIEWS,
            )

        if not review:
            _code, verdict, stdout = run_command('claude-review', repository, number, sha)
            failed = failed_reviews(review_dir)
            detail = parse_child_detail(stdout, 'claude-review')
            rounds_used, rounds_allowed = parse_child_rounds(stdout, 'claude-review')
            if verdict == 'FAIL':
                rounds_used = len(failed)
                rounds_allowed = MAX_FAILED_REVIEWS
            finish(
                verdict, sha,
                next_step=next_for(verdict, failed=failed if verdict == 'FAIL' else None),
                detail_file=detail if verdict == 'FAIL' else None,
                rounds_used=rounds_used, rounds_allowed=rounds_allowed,
            )

        # Both results for this head are already stored.
        verdict = review['verdict']
        failed = failed_reviews(review_dir)
        detail = None
        rounds_used = rounds_allowed = None
        if verdict == 'FAIL':
            detail = os.path.join(review_dir, f'{review["_stem"]}.md')
            rounds_used = len(failed)
            rounds_allowed = MAX_FAILED_REVIEWS
        finish(
            verdict, sha,
            next_step=next_for(verdict, failed=failed if verdict == 'FAIL' else None),
            detail_file=detail,
            rounds_used=rounds_used, rounds_allowed=rounds_allowed,
        )
    finally:
        fcntl.flock(lock.fileno(), fcntl.LOCK_UN)
        lock.close()


def find_passing_review(directory, sha, title):
    if not os.path.isdir(directory):
        return None
    for name in sorted(os.listdir(directory)):
        if not name.endswith('.json'):
            continue
        path = os.path.join(directory, name)
        with open(path, encoding='utf-8') as file:
            data = json.load(file)
        if data.get('sha') == sha and data.get('title') == title and data.get('verdict') == 'PASS':
            return data
    return None


def pr_snapshot(repository, number):
    view = checks.gh(
        'pr', 'view', str(number), '--repo', repository,
        '--json', 'headRefOid,title,isDraft,reviews',
    )
    if view.returncode:
        fail(f'{checks.GH} pr view failed: {view.stderr.strip()}')
    return json.loads(view.stdout)


def run_uat_verify(repository, number, sha):
    result = subprocess.run(
        ['uat-test', '--verify', repository, str(number), sha],
        capture_output=True, text=True,
    )
    if result.stdout:
        sys.stderr.write(result.stdout)
    if result.stderr:
        sys.stderr.write(result.stderr)
    return result.returncode


def checks_status(repository, number):
    """Return 'pass', 'pending', or 'fail' for the PR's required (or all) checks."""
    required = checks.gh('pr', 'checks', str(number), '--required', '--repo', repository)
    if required.returncode == 8:
        return 'pending'
    if required.returncode not in (0, 1):
        fail(f'{checks.GH} pr checks --required failed: {required.stderr.strip()}', checks.Exit.RETRY)
    no_required = required.returncode == 0 and 'no required checks' in (required.stderr or '').lower()
    if required.returncode == 0 and not no_required:
        return 'pass'
    if required.returncode == 1 and not no_required:
        return 'fail'
    all_checks = checks.gh('pr', 'checks', str(number), '--repo', repository)
    if all_checks.returncode == 8:
        return 'pending'
    if all_checks.returncode == 0:
        return 'pass'
    if all_checks.returncode == 1:
        return 'fail'
    fail(f'{checks.GH} pr checks failed: {all_checks.stderr.strip()}', checks.Exit.RETRY)


def changes_requested(reviews):
    return any((review or {}).get('state') == 'CHANGES_REQUESTED' for review in (reviews or []))


def unmet(name, sha):
    finish('PRECONDITION', sha, next_step=name)


def evaluate_merge():
    """Check every Delivery merge condition; exit on unmet. Return repo, number, sha, title."""
    repository, number, sha = resolve()
    pr = pr_snapshot(repository, number)
    if pr['headRefOid'] != sha:
        fail(f'the PR head is {pr["headRefOid"]}, not {sha}: run against the current head')
    title = pr['title']
    if pr.get('isDraft'):
        unmet('mark ready', sha)

    review_dir = checks.history_dir('claude-review', repository, number)
    if not find_passing_review(review_dir, sha, title):
        unmet('passing review', sha)

    if uat_on():
        code = run_uat_verify(repository, number, sha)
        if code != 0:
            unmet('uat-test --verify', sha)

    status = checks_status(repository, number)
    if status == 'pending':
        finish('RETRY', sha, next_step='retry')
    if status == 'fail':
        unmet('checks', sha)

    if changes_requested(pr.get('reviews')):
        unmet('changes requested', sha)

    return repository, number, sha, title


def dry_run_merge():
    _repository, _number, sha, _title = evaluate_merge()
    finish('PASS', sha, next_step='merge')


def run_merge():
    repository, number, sha, title = evaluate_merge()
    subject = f'{title} (#{number})'
    result = checks.gh(
        'pr', 'merge', str(number),
        '--squash',
        '--match-head-commit', sha,
        '--subject', subject,
        '--repo', repository,
    )
    if result.returncode:
        message = (result.stderr or result.stdout or 'merge refused').strip()
        fail(message, checks.Exit.BLOCKED)
    finish('PASS', sha, next_step='done')


IMAGE_TEMPLATES = '/usr/local/share/superagent/templates'
INIT_FILES = ('AGENTS.md', os.path.join('.superagent', 'uat.yaml'))
INIT_TREES = (os.path.join('.agents', 'skills'),)


def template_root():
    """Resolve templates/: checkout next to scripts/, else image-baked copy."""
    script_dir = os.path.dirname(os.path.abspath(__file__))
    checkout = os.path.join(os.path.dirname(script_dir), 'templates')
    if os.path.isdir(checkout):
        return checkout
    if os.path.isdir(IMAGE_TEMPLATES):
        return IMAGE_TEMPLATES
    fail(f'templates not found at {checkout} or {IMAGE_TEMPLATES}')


def init_plan(root):
    """Return (src, dest_rel) pairs under template root for init to copy."""
    pairs = []
    for rel in INIT_FILES:
        src = os.path.join(root, rel)
        if not os.path.isfile(src):
            fail(f'template missing: {rel}')
        pairs.append((src, rel))
    for rel in INIT_TREES:
        src = os.path.join(root, rel)
        if not os.path.isdir(src):
            fail(f'template missing: {rel}')
        for dirpath, _dirnames, filenames in os.walk(src):
            for name in filenames:
                full = os.path.join(dirpath, name)
                pairs.append((full, os.path.relpath(full, root)))
    return pairs


def run_init(target, force=False):
    if not target:
        fail(f'usage: {CHECK} init <dir> [--force]')
    target = os.path.abspath(target)
    if not os.path.isdir(target):
        fail(f'target is not a directory: {target}')
    root = template_root()
    pairs = init_plan(root)
    existing = [rel for _src, rel in pairs if os.path.lexists(os.path.join(target, rel))]
    if existing and not force:
        fail(f'refusing to overwrite existing path(s): {", ".join(existing)} (use --force)')
    for src, rel in pairs:
        dest = os.path.join(target, rel)
        os.makedirs(os.path.dirname(dest), exist_ok=True)
        shutil.copy2(src, dest)
    print(f'{CHECK} init: wrote {len(pairs)} file(s) into {target}')


def parse_init_args(args):
    force = False
    positional = []
    for arg in args:
        if arg == '--force':
            force = True
            continue
        if arg.startswith('-'):
            fail(f'usage: {CHECK} init <dir> [--force]')
        positional.append(arg)
    if len(positional) != 1:
        fail(f'usage: {CHECK} init <dir> [--force]')
    return positional[0], force


def upgrade_plan(root):
    """Return (src, dest_rel) pairs for skills refresh under template root."""
    pairs = []
    for rel in INIT_TREES:
        src = os.path.join(root, rel)
        if not os.path.isdir(src):
            fail(f'template missing: {rel}')
        for dirpath, _dirnames, filenames in os.walk(src):
            for name in filenames:
                full = os.path.join(dirpath, name)
                pairs.append((full, os.path.relpath(full, root)))
    return pairs


def parse_upgrade_args(args):
    positional = []
    for arg in args:
        if arg.startswith('-'):
            fail(f'usage: {CHECK} upgrade <dir>')
        positional.append(arg)
    if len(positional) != 1:
        fail(f'usage: {CHECK} upgrade <dir>')
    return positional[0]


def _file_digest(path):
    if not os.path.isfile(path):
        return None
    with open(path, 'rb') as file:
        return file.read()


def classify_upgrade(target, pairs):
    """Compare target paths to templates before copy: added / updated / unchanged."""
    added, updated, unchanged = [], [], []
    for src, rel in pairs:
        dest = os.path.join(target, rel)
        before = _file_digest(dest)
        after = _file_digest(src)
        if before is None:
            added.append(rel)
        elif before != after:
            updated.append(rel)
        else:
            unchanged.append(rel)
    return added, updated, unchanged


def write_upgrade_work_order(target, added, updated, unchanged):
    """Write .superagent/UPGRADE.md as a human/agent work order of what changed."""
    path = os.path.join(target, '.superagent', 'UPGRADE.md')
    os.makedirs(os.path.dirname(path), exist_ok=True)
    lines = [
        '# Superagent upgrade',
        '',
        'Work order from `superagent upgrade`. Planning skills under',
        '`.agents/skills/` were refreshed from the deployment templates.',
        '`AGENTS.md` and `.superagent/uat.yaml` were left untouched.',
        '',
        '## Changed',
        '',
    ]
    if not added and not updated:
        lines.append('- No skill file content changed (already matched templates).')
        lines.append('')
    else:
        if added:
            lines.append('### Added')
            lines.append('')
            for rel in added:
                lines.append(f'- `{rel}`')
            lines.append('')
        if updated:
            lines.append('### Updated')
            lines.append('')
            for rel in updated:
                lines.append(f'- `{rel}` refreshed from templates')
            lines.append('')
    if unchanged:
        lines.append('### Unchanged')
        lines.append('')
        lines.append(f'- {len(unchanged)} skill file(s) already matched templates')
        lines.append('')
    lines.extend([
        '## Steps',
        '',
        '1. **Review** every Added/Updated path under `.agents/skills/`.',
        '   Done when: you have read each listed file (or confirmed the diff).',
        '2. **Apply** any new planning guidance this repository needs',
        '   (issue format, ADRs, UAT sections). Done when: follow-up edits',
        '   are staged or an issue tracks them.',
        '3. **Commit** the refreshed skills and this work order together.',
        '   Done when: `git status` is clean for `.agents/skills/` and',
        '   `.superagent/UPGRADE.md`.',
        '',
    ])
    with open(path, 'w', encoding='utf-8') as file:
        file.write('\n'.join(lines))


def run_upgrade(target):
    if not target:
        fail(f'usage: {CHECK} upgrade <dir>')
    target = os.path.abspath(target)
    if not os.path.isdir(target):
        fail(f'target is not a directory: {target}')
    root = template_root()
    pairs = upgrade_plan(root)
    added, updated, unchanged = classify_upgrade(target, pairs)
    for src, rel in pairs:
        dest = os.path.join(target, rel)
        os.makedirs(os.path.dirname(dest), exist_ok=True)
        shutil.copy2(src, dest)
    write_upgrade_work_order(target, added, updated, unchanged)
    print(
        f'{CHECK} upgrade: refreshed {len(pairs)} skill file(s) in {target}; '
        f'wrote .superagent/UPGRADE.md'
    )


def main(args):
    if args == ['check', '--dry-run']:
        dry_run()
    if args == ['check']:
        run_check()
    if args == ['merge', '--dry-run']:
        dry_run_merge()
    if args == ['merge']:
        run_merge()
    if args and args[0] == 'init':
        target, force = parse_init_args(args[1:])
        run_init(target, force=force)
        sys.exit(checks.Exit.PASS)
    if args and args[0] == 'upgrade':
        target = parse_upgrade_args(args[1:])
        run_upgrade(target)
        sys.exit(checks.Exit.PASS)
    fail(
        f'usage: {CHECK} check [--dry-run] | merge [--dry-run] | init <dir> [--force] | upgrade <dir>',
        checks.Exit.PRECONDITION,
    )


if __name__ == '__main__':
    main(sys.argv[1:])
