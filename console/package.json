{
  "name": "superagent-console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch server.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts && tsc -p tsconfig.server.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p web/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.106",
    "@assistant-ui/ai-sdk": "0.0.19",
    "@assistant-ui/react": "0.15.37",
    "@hono/node-server": "1.19.19",
    "ai": "7.0.177",
    "hono": "4.13.19",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "24.12.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.4",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.1",
    "vitest": "4.1.12"
  }
}
