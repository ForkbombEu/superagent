# Use Coolify's Environment Variables for real deployment, not this file.
DEEPSEEK_API_KEY=replace-with-api-key
GH_TOKEN=replace-with-classic-github-token
GITHUB_REPOSITORY=ForkbombEu/credimi-attestbook
SUPERAGENT_DOMAIN=superagent.example.com
BASIC_AUTH_USERNAME=admin
# Generate hash: docker run --rm caddy:2.10-alpine caddy hash-password --plaintext 'CHOOSE_A_STRONG_PASSWORD'
# Paste bcrypt hash into Coolify as BASIC_AUTH_PASSWORD_HASH (retain $ signs).
BASIC_AUTH_PASSWORD_HASH=replace-with-bcrypt-hash
