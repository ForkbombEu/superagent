# Use Coolify's Environment Variables for real deployment, not this file.
DEEPSEEK_API_KEY=replace-with-api-key
GH_TOKEN=replace-with-classic-github-token
GITHUB_REPOSITORY=ForkbombEu/credimi-attestbook
# Claude Code PR reviewer: set one. Subscription token from `claude setup-token`, or an API key.
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=
# Set by Coolify from the domain of the "dashboard" service; only for running outside Coolify.
SERVICE_URL_DASHBOARD=https://superagent.example.com
SERVICE_FQDN_DASHBOARD=superagent.example.com
# Optional: applied to the Superagent settings on every start; leave empty to manage in the panel.
# GitHub logins that may ask for work, comma- or space-separated.
SUPERAGENT_GITHUB_ALLOWED_USERS=
# Executor model; provider and model ids as the panel's model picker lists them.
SUPERAGENT_EXECUTOR_PROVIDER=
SUPERAGENT_EXECUTOR_MODEL=
SUPERAGENT_EXECUTOR_REASONING_EFFORT=
