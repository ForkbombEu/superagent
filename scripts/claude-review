#!/usr/bin/env python3
"""Claude Code review of one pull request commit, for dsh-superagent workers.

Usage, in the ticket directory: claude-review <owner/repo> <pr number> <head sha>

dsh-superagent limits its workers to a fixed tool list without the DSH Claude Code
subagent tool, so they run this through bash instead. It checks that <head sha> is
both the PR's head on GitHub and the checked-out HEAD, and runs Claude Code on it in
a temporary checkout, where it may run the tests, with the prompt in
/usr/local/share/superagent/review-prompt.md and this PR's earlier reviews.

Claude Code answers with a Summary, a Review and a Fix plan. The Summary is posted
on the PR; the whole answer is printed for the worker and kept, as the history the
next review of this PR starts from, under ~/.local/state/claude-review.

Exit status: 0 PASS, 1 FAIL, 2 no usable review (nothing posted), 3 review done
but the comment could not be posted.
"""
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time

PROMPT = '/usr/local/share/superagent/review-prompt.md'
# Written by superagent-entrypoint.sh: the Claude credential, model and effort,
# which DSH strips from worker shells as it does every *_TOKEN/*_KEY variable.
CONFIG = '/run/superagent-secrets/claude-review.json'
CHECKOUTS = '/tmp/claude-review'
HISTORY = os.path.expanduser('~/.local/state/claude-review')
DISCLOSURE = 'This is by an automated agent, not a human.'
TIMEOUT_SECONDS = 1800
# GitHub rejects comments over 65536 characters.
MAX_COMMENT = 60000
# The prompt goes to Claude Code as one argument, which Linux caps at 128 KiB.
MAX_HISTORY = 80000


def fail(message, status=2):
    print(f'claude-review: {message}', file=sys.stderr)
    sys.exit(status)


def run(*command):
    result = subprocess.run(command, capture_output=True, text=True)
    if result.returncode:
        fail(f'{" ".join(command[:3])} failed: {result.stderr.strip()}')
    return result.stdout.strip()


def section(answer, heading):
    """The text under `## <heading>` up to the next `## ` heading or the verdict lines."""
    match = re.search(rf'^## {heading}[ \t]*\n(.*?)(?=^## |^VERDICT: |\Z)', answer, re.MULTILINE | re.DOTALL)
    return match.group(1).strip() if match else ''


def history(directory, repository, number):
    """Earlier reviews of this PR: every summary, and the latest review in full."""
    reviews = sorted(name for name in os.listdir(directory) if name.endswith('.md')) if os.path.isdir(directory) else []
    if not reviews:
        return ('No earlier review of this PR is stored. Earlier reviews may be on the PR as `**Claude Code review**` '
                f'comments: read them with `gh pr view {number} --repo {repository} --comments`.')
    texts = []
    for name in reviews:
        with open(os.path.join(directory, name), encoding='utf-8') as file:
            texts.append((name, file.read()))
    summaries = [f'### Review {index} ({name.removesuffix(".md")})\n{section(text, "Summary") or text[-3000:]}'
                 for index, (name, text) in enumerate(texts, 1)]
    latest = texts[-1][1][:MAX_HISTORY // 2]
    return ('\n\n'.join(summaries)[-MAX_HISTORY // 2:]
            + f'\n\n### The latest review in full, with the fix plan the author was given\n{latest}')


def main():
    if len(sys.argv) != 4 or not re.fullmatch(r'[0-9a-f]{40}', sys.argv[3]):
        fail('usage: claude-review <owner/repo> <pr number> <full 40-character head sha>')
    repository, number, sha = sys.argv[1:]
    pr = json.loads(run('gh', 'pr', 'view', number, '--repo', repository, '--json', 'headRefOid,baseRefName,title'))
    if pr['headRefOid'] != sha:
        fail(f'the PR head is {pr["headRefOid"]}, not {sha}: review the current head')
    if run('git', 'rev-parse', 'HEAD') != sha:
        fail(f'the working directory is not at {sha}')
    run('git', 'fetch', '--no-tags', 'origin', pr['baseRefName'])

    stored = os.path.join(HISTORY, repository, f'pr-{number}')
    values = {'<repository>': repository, '<number>': number, '<title>': pr['title'], '<base branch>': pr['baseRefName'],
              '<sha>': sha, '<history>': history(stored, repository, number)}
    with open(PROMPT, encoding='utf-8') as file:
        # One pass, so text from the history is never substituted again.
        prompt = re.sub('|'.join(map(re.escape, values)), lambda match: values[match.group(0)], file.read())
    with open(CONFIG, encoding='utf-8') as file:
        config = json.load(file)
    command = ['claude', '-p', prompt, '--output-format', 'json', '--permission-mode', 'dontAsk',
               *(['--model', config['model']] if config.get('model') else [])]
    # GitHub tokens stay out of Claude Code's environment.
    inherited = {name: value for name, value in os.environ.items() if name not in ('GH_TOKEN', 'GITHUB_TOKEN')}
    # A detached checkout of <sha> of its own: installing dependencies and running
    # tests leave the worker's directory alone, and the checkout is deleted after.
    # mise trusts this root (MISE_TRUSTED_CONFIG_PATHS in the Dockerfile).
    os.makedirs(CHECKOUTS, exist_ok=True)
    checkout = tempfile.mkdtemp(dir=CHECKOUTS)
    run('git', 'worktree', 'add', '--detach', checkout, sha)
    try:
        # The toolchain the PR pins in mise.toml; a failure is Claude Code's to report.
        try:
            subprocess.run(['mise', '--cd', checkout, 'install'], capture_output=True, timeout=600)
        except subprocess.TimeoutExpired:
            pass
        result = subprocess.run(command, capture_output=True, text=True, timeout=TIMEOUT_SECONDS,
                                cwd=checkout, env={**inherited, **config['env']})
    except subprocess.TimeoutExpired:
        fail(f'Claude Code did not finish within {TIMEOUT_SECONDS} s')
    finally:
        subprocess.run(['git', 'worktree', 'remove', '--force', checkout], capture_output=True)
        shutil.rmtree(checkout, ignore_errors=True)
    try:
        output = json.loads(result.stdout)
    except ValueError:
        fail(f'Claude Code failed (exit {result.returncode}): {result.stderr.strip()[-2000:]}')
    answer = (output.get('result') or '').strip()
    if output.get('is_error') or not answer:
        fail(f'Claude Code returned no review: {output.get("subtype")} {answer[-2000:]}'.rstrip())

    lines = [line.strip() for line in answer.splitlines() if line.strip()]
    verdict = re.fullmatch(r'VERDICT: (PASS|FAIL)', lines[-2]) if len(lines) >= 2 else None
    if not verdict or lines[-1] != f'REVIEWED_SHA: {sha}':
        print(answer)
        fail('the answer does not end with a verdict for this commit; not posted')

    os.makedirs(stored, exist_ok=True)
    saved = os.path.join(stored, f'{time.strftime("%Y%m%dT%H%M%SZ", time.gmtime())}-{sha[:12]}.md')
    with open(saved, 'w', encoding='utf-8') as file:
        file.write(answer + '\n')

    # People get the summary; without one, the whole answer, so a review is never lost.
    summary = section(answer, 'Summary') or answer
    if len(summary) > MAX_COMMENT:
        summary = summary[:MAX_COMMENT] + '\n\n(Truncated to fit a GitHub comment.)'
    body = f'{DISCLOSURE}\n\n**Claude Code review** of {sha}: **{verdict.group(1)}**\n\n{summary}\n'
    posted = subprocess.run(['gh', 'pr', 'comment', number, '--repo', repository, '--body-file', '-'],
                            input=body, capture_output=True, text=True)
    print(answer)
    # Long tool output may be pruned in the worker's context; the file keeps it whole.
    print(f'\nclaude-review: the whole review, with its Fix plan, is in {saved}')
    print(f'claude-review: {verdict.group(1)} for {sha}, title: {pr["title"]}')
    passed = verdict.group(1) == 'PASS'
    if posted.returncode:
        fail(f'the review could not be posted: {posted.stderr.strip()}', 3)
    sys.exit(0 if passed else 1)


if __name__ == '__main__':
    main()
