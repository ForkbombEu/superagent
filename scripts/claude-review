#!/usr/bin/env python3
"""Claude Code review of one pull request commit, for dsh-superagent workers.

Usage, in the ticket directory: claude-review <owner/repo> <pr number> <head sha>

dsh-superagent limits its workers to a fixed tool list without the DSH Claude Code
subagent tool, so they run this through bash instead. It checks that <head sha> is
both the PR's head on GitHub and the checked-out HEAD, and runs Claude Code on it in
a temporary checkout, where it may run the tests, with the prompt in
/usr/local/share/superagent/review-prompt.md and this PR's earlier reviews.

Claude Code answers with a Summary, a Review and a Fix plan. The Summary is posted
on the PR; the whole answer is kept under ~/.local/state/claude-review with its sha,
title and verdict. A later run for the same sha and title reuses that stored review
(and posts it if the comment is still missing) instead of calling Claude again.

When the deployment runs user acceptance tests, it reviews only a <head sha>
whose UAT passed (or needs none) and still holds (`uat-test --verify`).

Exit status (shared check contract): 0 PASS, 1 FAIL, 3 retry (no usable review, or
the comment could not be posted), 4 precondition (UAT has not passed for <head sha>).
"""
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import superagent_checks as checks

PROMPT = os.environ.get('CLAUDE_REVIEW_PROMPT', '/usr/local/share/superagent/review-prompt.md')
# Written by superagent-entrypoint.sh: the Claude credential, model and effort,
# which DSH strips from worker shells as it does every *_TOKEN/*_KEY variable.
CONFIG = os.environ.get('CLAUDE_REVIEW_CONFIG', '/run/superagent-secrets/claude-review.json')
# Written by superagent-entrypoint.sh when user acceptance tests are on.
UAT_CONFIG = os.environ.get('UAT_TEST_CONFIG', '/run/superagent-secrets/uat.json')
CHECKOUTS = os.environ.get('CLAUDE_REVIEW_CHECKOUTS', '/tmp/claude-review')
TIMEOUT_SECONDS = 1800
# The prompt goes to Claude Code as one argument, which Linux caps at 128 KiB.
MAX_HISTORY = 80000
CHECK = 'claude-review'
MAX_FAILED_REVIEWS = 3


def fail(message, status=checks.Exit.RETRY):
    print(f'{CHECK}: {message}', file=sys.stderr)
    sys.exit(status)


def run(*command):
    result = subprocess.run(command, capture_output=True, text=True)
    if result.returncode:
        fail(f'{" ".join(command[:3])} failed: {result.stderr.strip()}')
    return result.stdout.strip()


def section(answer, heading):
    """The text under `## <heading>` up to the next `## ` heading or the verdict lines."""
    match = re.search(rf'^## {heading}[ \t]*\n(.*?)(?=^## |^VERDICT: |\Z)', answer, re.MULTILINE | re.DOTALL)
    return match.group(1).strip() if match else ''


def history(directory, repository, number):
    """Earlier reviews of this PR: every summary, and the latest review in full."""
    names = sorted(os.listdir(directory)) if os.path.isdir(directory) else []
    texts = []
    json_stems = {name[:-5] for name in names if name.endswith('.json')}
    for name in names:
        path = os.path.join(directory, name)
        if name.endswith('.json'):
            with open(path, encoding='utf-8') as file:
                data = json.load(file)
            texts.append((name, data.get('answer') or ''))
        elif name.endswith('.md') and name[:-3] not in json_stems:
            with open(path, encoding='utf-8') as file:
                texts.append((name, file.read()))
    if not texts:
        return ('No earlier review of this PR is stored. Earlier reviews may be on the PR as `**Claude Code review**` '
                f'comments: read them with `gh pr view {number} --repo {repository} --comments`.')
    summaries = [
        f'### Review {index} ({name.removesuffix(".json").removesuffix(".md")})\n'
        f'{section(text, "Summary") or text[-3000:]}'
        for index, (name, text) in enumerate(texts, 1)
    ]
    latest = texts[-1][1][:MAX_HISTORY // 2]
    return ('\n\n'.join(summaries)[-MAX_HISTORY // 2:]
            + f'\n\n### The latest review in full, with the fix plan the author was given\n{latest}')


def review_marker(sha, title):
    digest = hashlib.sha256(title.encode()).hexdigest()[:12]
    return f'{sha}-{digest}'


def load_reviews(directory):
    if not os.path.isdir(directory):
        return []
    rows = []
    for name in sorted(os.listdir(directory)):
        if not name.endswith('.json'):
            continue
        path = os.path.join(directory, name)
        with open(path, encoding='utf-8') as file:
            data = json.load(file)
        data['_path'] = path
        data['_stem'] = name[:-5]
        rows.append(data)
    return rows


def find_review(directory, sha, title):
    for row in load_reviews(directory):
        if row.get('sha') == sha and row.get('title') == title:
            return row
    return None


def failed_review_names(directory):
    return [f'{row["_stem"]}.md' for row in load_reviews(directory) if row.get('verdict') == 'FAIL']


def save_review(directory, sha, title, verdict, answer):
    os.makedirs(directory, exist_ok=True)
    # One record per sha+title: a title change keeps the earlier review and stores a new one.
    stem = review_marker(sha, title)
    payload = {'sha': sha, 'title': title, 'verdict': verdict, 'answer': answer}
    with open(os.path.join(directory, f'{stem}.json'), 'w', encoding='utf-8') as file:
        json.dump(payload, file, indent=2)
        file.write('\n')
    md_path = os.path.join(directory, f'{stem}.md')
    with open(md_path, 'w', encoding='utf-8') as file:
        file.write(answer + '\n')
    return md_path


def finish(verdict, sha, *, detail_file=None, failed=None, posted=True):
    next_step = rounds_used = rounds_allowed = None
    show_detail = None
    if verdict == 'FAIL':
        names = failed or []
        rounds_used = len(names)
        rounds_allowed = MAX_FAILED_REVIEWS
        next_step = (
            f'failed reviews so far: {", ".join(names)}'
            if names else 'failed reviews so far: (none)'
        )
        show_detail = detail_file
    result = checks.Result(
        check=CHECK, verdict=verdict, sha=sha,
        rounds_used=rounds_used, rounds_allowed=rounds_allowed,
        next_step=next_step, detail_file=show_detail,
    )
    code = checks.print_result(result)
    if not posted:
        fail('the review could not be posted', checks.Exit.RETRY)
    sys.exit(code)


def comment_body(sha, verdict, answer):
    summary = section(answer, 'Summary') or answer
    return f'**Claude Code review** of {sha}: **{verdict}**\n\n{summary}\n'


def post_review(repository, number, sha, title, verdict, answer, directory):
    return checks.pr_comment(
        repository, number, comment_body(sha, verdict, answer),
        directory=directory, marker=review_marker(sha, title),
    )


def run_claude(repository, number, sha, title, base, directory):
    values = {
        '<repository>': repository, '<number>': number, '<title>': title,
        '<base branch>': base, '<sha>': sha, '<history>': history(directory, repository, number),
    }
    with open(PROMPT, encoding='utf-8') as file:
        # One pass, so text from the history is never substituted again.
        prompt = re.sub('|'.join(map(re.escape, values)), lambda match: values[match.group(0)], file.read())
    with open(CONFIG, encoding='utf-8') as file:
        config = json.load(file)
    command = ['claude', '-p', prompt, '--output-format', 'json', '--permission-mode', 'dontAsk',
               *(['--model', config['model']] if config.get('model') else [])]
    # GitHub tokens stay out of Claude Code's environment.
    inherited = {name: value for name, value in os.environ.items() if name not in ('GH_TOKEN', 'GITHUB_TOKEN')}
    claude_env = dict(inherited)
    claude_env.update(config.get('env') or {})
    # A detached checkout of <sha> of its own: installing dependencies and running
    # tests leave the worker's directory alone, and the checkout is deleted after.
    # mise trusts this root (MISE_TRUSTED_CONFIG_PATHS in the Dockerfile).
    os.makedirs(CHECKOUTS, exist_ok=True)
    checkout = tempfile.mkdtemp(dir=CHECKOUTS)
    run('git', 'worktree', 'add', '--detach', checkout, sha)
    try:
        # The toolchain the PR pins in mise.toml; a failure is Claude Code's to report.
        try:
            subprocess.run(['mise', '--cd', checkout, 'install'], capture_output=True, timeout=600)
        except (subprocess.TimeoutExpired, FileNotFoundError):
            pass
        result = subprocess.run(command, capture_output=True, text=True, timeout=TIMEOUT_SECONDS,
                                cwd=checkout, env=claude_env)
    except subprocess.TimeoutExpired:
        fail(f'Claude Code did not finish within {TIMEOUT_SECONDS} s')
    finally:
        subprocess.run(['git', 'worktree', 'remove', '--force', checkout], capture_output=True)
        shutil.rmtree(checkout, ignore_errors=True)
    try:
        output = json.loads(result.stdout)
    except ValueError:
        fail(f'Claude Code failed (exit {result.returncode}): {result.stderr.strip()[-2000:]}')
    answer = (output.get('result') or '').strip()
    if output.get('is_error') or not answer:
        fail(f'Claude Code returned no review: {output.get("subtype")} {answer[-2000:]}'.rstrip())

    lines = [line.strip() for line in answer.splitlines() if line.strip()]
    verdict = re.fullmatch(r'VERDICT: (PASS|FAIL)', lines[-2]) if len(lines) >= 2 else None
    if not verdict or lines[-1] != f'REVIEWED_SHA: {sha}':
        print(answer)
        fail('the answer does not end with a verdict for this commit; not posted')
    return verdict.group(1), answer


def main():
    if len(sys.argv) != 4 or not re.fullmatch(r'[0-9a-f]{40}', sys.argv[3]):
        fail(f'usage: {CHECK} <owner/repo> <pr number> <full 40-character head sha>', checks.Exit.PRECONDITION)
    repository, number, sha = sys.argv[1:]
    view = checks.gh('pr', 'view', number, '--repo', repository, '--json', 'headRefOid,baseRefName,title')
    if view.returncode:
        fail(f'{checks.GH} pr view failed: {view.stderr.strip()}', checks.Exit.PRECONDITION)
    pr = json.loads(view.stdout)
    if pr['headRefOid'] != sha:
        fail(f'the PR head is {pr["headRefOid"]}, not {sha}: review the current head', checks.Exit.PRECONDITION)
    if run('git', 'rev-parse', 'HEAD') != sha:
        fail(f'the working directory is not at {sha}', checks.Exit.PRECONDITION)
    if os.path.exists(UAT_CONFIG):
        # UAT comes first: no review of a head without a UAT pass that still holds for it.
        check = subprocess.run(['uat-test', '--verify', repository, number, sha], capture_output=True, text=True)
        if check.returncode:
            fail(f'UAT has not passed for {sha}: run `uat-test {repository} {number} {sha}` first '
                 f'({(check.stdout + check.stderr).strip()[-500:]})', checks.Exit.PRECONDITION)
    title = pr['title']
    directory = checks.history_dir(CHECK, repository, number)
    stored = find_review(directory, sha, title)
    if stored:
        detail = os.path.join(directory, f'{stored["_stem"]}.md')
        posted = post_review(repository, number, sha, title, stored['verdict'], stored['answer'], directory)
        finish(stored['verdict'], sha, detail_file=detail, failed=failed_review_names(directory), posted=posted)

    run('git', 'fetch', '--no-tags', 'origin', pr['baseRefName'])
    verdict, answer = run_claude(repository, number, sha, title, pr['baseRefName'], directory)
    detail = save_review(directory, sha, title, verdict, answer)
    posted = post_review(repository, number, sha, title, verdict, answer, directory)
    finish(verdict, sha, detail_file=detail, failed=failed_review_names(directory), posted=posted)


if __name__ == '__main__':
    main()
