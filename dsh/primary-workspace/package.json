{
  "name": "superagent-primary-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Register $HOME/src/<GITHUB_REPOSITORY> as the primary DSH Workspace for Claude sessions.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "package.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "manifestVersion": 1
  },
  "engines": {
    "dsh": "^0.2.1-alpha.2"
  }
}
